{
  "verified": "2026-11-19",
  "ios": {
    "name": { "max": 30, "min": 2, "unit": "chars", "indexed": true, "fill": 0.9 },
    "subtitle": { "max": 30, "unit": "chars", "indexed": true, "fill": 0.9 },
    "keywords": { "max": 100, "unit": "bytes", "indexed": true, "minTerm": 3, "fillTarget": 90 },
    "promotionalText": { "max": 170, "unit": "chars", "indexed": false },
    "description": { "max": 4000, "unit": "chars", "indexed": false },
    "whatsNew": { "max": 4000, "unit": "chars", "indexed": false }
  },
  "play": {
    "title": { "max": 30, "unit": "chars", "indexed": true, "fill": 0.9 },
    "shortDescription": { "max": 80, "unit": "chars", "indexed": "disputed", "fill": 0.9 },
    "fullDescription": {
      "max": 4000,
      "unit": "chars",
      "indexed": true,
      "primaryMentions": [3, 5],
      "maxDensity": 0.04
    },
    "releaseNotes": { "max": 500, "unit": "chars", "indexed": "unverified" }
  },
  "banned": {
    "iosKeywords": ["app", "apps", "game", "games", "free", "iphone", "ipad", "ios", "new", "best", "the", "and", "for", "with", "to", "of", "a", "an"],
    "iosAll": ["android", "google play", "play store", "for kids", "for children", "world's best", "#1"],
    "playTitle": ["free", "no ads", "best", "top", "#1", "new", "popular", "editor's choice", "sale", "discount", "% off", "app of the year"],
    "playShort": ["free", "no ads", "best", "top", "#1", "new", "discount", "sale", "download now", "install now", "play now", "try now", "million downloads"],
    "playFull": ["#1 rated", "best", "app store", "iphone", "ios"],
    "locale": {
      "de": ["kostenlos", "gratis", "beste"],
      "fr": ["gratuit", "meilleur", "meilleure"],
      "es": ["gratis", "mejor"],
      "it": ["gratis", "gratuito", "migliore"],
      "pt": ["grátis", "gratis", "melhor"],
      "nl": ["gratis", "beste"],
      "ru": ["бесплатно", "бесплатный", "лучший"],
      "uk": ["безкоштовно", "найкращий"],
      "pl": ["darmowy", "za darmo", "najlepszy"],
      "tr": ["ücretsiz", "en iyi"],
      "ja": ["無料", "最高"],
      "ko": ["무료", "최고"],
      "zh": ["免费", "最好", "第一"]
    }
  },
  "patterns": {
    "emoji": "\\p{Extended_Pictographic}",
    "repeatedPunctuation": "([!?.*★])\\1",
    "allCapsWord": "\\b[A-Z]{4,}\\b"
  },
  "lists": {
    "ios.events": {
      "maxItems": 10,
      "indexed": "disputed",
      "fields": {
        "name": { "max": 30, "unit": "chars" },
        "short": { "max": 50, "unit": "chars" },
        "long": { "max": 120, "unit": "chars" }
      }
    },
    "ios.iaps": {
      "indexed": true,
      "fields": {
        "name": {
          "max": 30,
          "unit": "chars",
          "disputed": [30, 35]
        },
        "description": {
          "max": 45,
          "unit": "chars",
          "disputed": [45, 55]
        }
      }
    },
    "ios.customProductPages": {
      "maxItems": 70,
      "indexed": false,
      "fields": {
        "promotionalText": { "max": 170, "unit": "chars" }
      }
    },
    "play.tags": { "maxItems": 5, "indexed": true },
    "play.promotionalContent": {
      "indexed": "unverified",
      "fields": {
        "title": { "max": 80, "unit": "chars", "source": "practitioner" },
        "description": { "max": 500, "unit": "chars", "source": "practitioner" }
      }
    }
  }
}
